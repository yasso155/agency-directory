# مسار ملف مفتاح Firebase (Service Account). لا ترفعه لأي مكان.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# معرّف الجروب. اتركه فاضي في البداية وشغّل: npm run groups
GROUP_JID=

# رقم البوت بالصيغة الدولية بدون + (مثال: 9665XXXXXXXX). يُستخدم للربط بكود بدل QR.
# اتركه فاضي لو عايز تربط بـ QR.
PAIRING_PHONE=

# مكان حفظ جلسة واتساب. لازم يبقى مجلد دائم (ما يتمسح عند إعادة التشغيل).
AUTH_DIR=./auth

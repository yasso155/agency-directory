rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function valid() {
      let d = request.resource.data;
      return d.id is string && d.id.size() > 0 && d.id.size() <= 100
        && d.id.matches('^[0-9]+$')
        && d.ar is string && d.ar.size() <= 200
        && d.en is string && d.en.size() <= 200
        && (!('pinned' in d) || d.pinned is bool);
    }

    match /agencies/{docId} {
      allow read, delete: if true;
      allow create, update: if valid();
    }
  }
}

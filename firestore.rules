rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. الوكالات: قراءة وإضافة وتعديل وحذف متاح للجميع
    match /agencies/{docId} {
      allow read, write: if true;
    }

    // 2. سجل التغذيات: القراءة والإضافة متاحة، والتعديل لإعادة المحاولة، والحذف ممنوع لحماية السجل
    match /topups/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 3. حالة اتصال البوت: القراءة فقط مسموحة للموقع، والكتابة من البوت بسيرفر السيرفر (Admin SDK)
    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
